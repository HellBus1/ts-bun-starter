{
  "name": "ts-bun-starter",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "docker compose --profile migrate run --rm liquibase",
    "db:migrate:test": "docker compose --profile migrate run --rm -e LIQUIBASE_COMMAND_URL=jdbc:postgresql://db:5432/ts_bun_starter_test liquibase",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && bun run db:migrate && bun run db:migrate:test"
  },
  "dependencies": {
    "elysia": "^1.2.25",
    "jose": "^6.2.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
